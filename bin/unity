#!/bin/sh
# unity: quick access to the Obsidian-backed Unity store.
#   unity add "Fix navigation" omp-unity
#   unity project "omp-unity"
#   unity items | projects
#   unity focus fix-navigation
#   unity set fix-navigation active
#   unity open fix-navigation

set -eu
CLI="${HOME}/.omp/agent/lib/unity-cli.mjs"
VAULT="${UNITY_VAULT:-}"
if [ -z "$VAULT" ] && [ -f "${HOME}/.omp/agent/AGENTS.local.md" ]; then
  VAULT=$(sed -n 's/^- Vault: //p' "${HOME}/.omp/agent/AGENTS.local.md" | head -1)
fi
if [ -z "$VAULT" ]; then
  echo "unity: no vault. Set UNITY_VAULT or add '- Vault: <path>' to AGENTS.local.md." >&2
  exit 1
fi
if [ ! -f "$CLI" ]; then
  echo "unity: store not found at $CLI. Run the bootstrap." >&2
  exit 1
fi

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  add)        exec node "$CLI" new "$VAULT" "$@" ;;
  project)    exec node "$CLI" project "$VAULT" "$@" ;;
  items|list) exec node "$CLI" items "$VAULT" ;;
  projects)   exec node "$CLI" projects "$VAULT" ;;
  focus)      if [ $# -gt 0 ]; then exec node "$CLI" focus-set "$VAULT" "$1"; else exec node "$CLI" focus "$VAULT"; fi ;;
  set)        exec node "$CLI" status "$VAULT" "$@" ;;
  item)       exec node "$CLI" item "$VAULT" "$@" ;;
  open)       [ $# -gt 0 ] || { echo "usage: unity open <item-id>" >&2; exit 2; }
              exec zsh "${HOME}/.omp/agent/launchers/omp-unity-macos.sh" --item "$1" ;;
  *)
    echo "usage: unity <add|project|items|projects|focus|set|item|open> ..." >&2
    echo "  unity add \"Fix navigation\" omp-unity" >&2
    exit 2
    ;;
esac
